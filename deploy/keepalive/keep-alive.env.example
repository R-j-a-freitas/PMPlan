# PMPlan — configuração do keep-alive na VPS.
#
# Este ficheiro é um MODELO. O ficheiro real vive FORA do repositório, em
#   /etc/pmplan/keep-alive.env    (root:root, modo 600 — ver DOCS/KEEP_ALIVE_VPS.md)
# e nunca deve ser copiado para dentro da árvore de código.
#
# root:root com 600 e não o utilizador do serviço: o systemd lê o EnvironmentFile como
# PID 1 (root) e só depois baixa privilégios para User=pmplan. O processo recebe as
# variáveis mas o utilizador pmplan nunca consegue ler o ficheiro — se o serviço for
# comprometido, o token não está acessível no disco a partir dele.

SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co

# ─── Autenticação (modo recomendado) ─────────────────────────────────────────
# Token do papel `pmplan_heartbeat` (migração 0011), gerado com:
#   SUPABASE_JWT_SECRET='…' SUPABASE_PROJECT_REF='…' node scripts/mint-heartbeat-token.mjs
#
# O que este token consegue fazer, e mais nada: inserir em system_heartbeat, contar PMs
# (só o número), disparar a purga. Verificado contra as 17 tabelas do schema — tem
# exactamente um privilégio, INSERT em system_heartbeat. Não lê pm_events, hospitais,
# perfis nem sequer os heartbeats que escreve.
#
# Continua a ser um segredo — quem o tiver pode escrever heartbeats falsos, o que
# mascararia uma paragem real. Mas não expõe dados.
SUPABASE_HEARTBEAT_TOKEN=cole-aqui-o-token-gerado

# Chave anon do projecto (Project Settings → API). NÃO é segredo: já vai no bundle do
# frontend e está sujeita ao RLS. Serve só para o gateway do Supabase deixar passar o
# pedido; quem decide o papel é o token acima.
SUPABASE_ANON_KEY=cole-aqui-a-anon-key

# ─── Autenticação (modo legado — evitar) ─────────────────────────────────────
# Se SUPABASE_HEARTBEAT_TOKEN não estiver definida, o script recorre a esta chave e
# escreve um WARN em cada execução. A service_role key tem BYPASSRLS: leitura e escrita
# totais sobre TODA a base de dados, incluindo contactos de hospitais e perfis. Só como
# recurso temporário.
# SUPABASE_SERVICE_ROLE_KEY=

# ─── Restante configuração ───────────────────────────────────────────────────
# Origem registada em system_heartbeat. Na VPS é sempre 'vps'; o GitHub Actions
# (Fase 3) corre o MESMO script com 'github_actions'. É o que permite distinguir
# "as duas origens vivas" de "uma morreu e a outra está a mascarar a falha".
HEARTBEAT_SOURCE=vps

# Log em ficheiro (rotação por logrotate — ver pmplan-keepalive.logrotate).
# Sem esta variável o script escreve só para stdout, que o systemd envia para o journal.
KEEPALIVE_LOG=/var/log/pmplan/keep-alive.log

# Opcionais — os valores por omissão servem para o caso normal.
# KEEPALIVE_TIMEOUT_MS=15000
# KEEPALIVE_ATTEMPTS=3

# ─── Verificador de falhas (heartbeat-check.mjs, Fase 3) ─────────────────────
# Usado pelo pmplan-heartbeat-check.timer. Se não instalar o verificador na VPS, estas
# podem ficar por preencher — mas nesse caso a detecção de falhas passa a depender
# exclusivamente do GitHub Actions, que o GitHub desactiva ao fim de 60 dias sem commits.

# Chave da API do Resend (a mesma que as Edge Functions já usam).
RESEND_API_KEY=

# Destinatário(s) do alerta, separados por vírgula. É o endereço que recebe o email
# quando o heartbeat pára ou quando o Supabase fica inacessível.
ALERT_EMAIL_TO=

# Remetente. Tem de ser um domínio verificado no Resend; o onboarding@resend.dev só
# entrega ao dono da conta, o que serve para testar mas não para alertar terceiros.
# RESEND_FROM_EMAIL=onboarding@resend.dev
# RESEND_FROM_NAME=PMPlan

# Idade máxima tolerada do heartbeat mais recente, em horas. 48 dá duas oportunidades de
# recuperação antes de o limite de 7 dias do Supabase se aproximar.
# HEARTBEAT_MAX_AGE_HOURS=48
