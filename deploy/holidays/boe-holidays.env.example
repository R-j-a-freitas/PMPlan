# PMPlan — configuração da importação dos feriados do BOE na VPS.
#
# MODELO. O ficheiro real vive FORA do repositório, em
#   /etc/pmplan/boe-holidays.env    (root:root, modo 600 — mesmo raciocínio do keep-alive.env)

SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co

# Chave anon (não é segredo; serve para o gateway deixar passar o pedido).
SUPABASE_ANON_KEY=cole-aqui-a-anon-key

# Token do papel `pmplan_holiday_sync` (migração 0025), gerado numa máquina de confiança:
#   TOKEN_ROLE=pmplan_holiday_sync SUPABASE_JWT_SECRET='…' SUPABASE_PROJECT_REF='…' \
#     node scripts/mint-heartbeat-token.mjs
#
# O que consegue fazer, e mais nada: saber se um ano já foi importado, importar uma lista
# de feriados regionais ES (validada pela BD) e registar tentativas. Não lê nem escreve
# tabela nenhuma directamente.
SUPABASE_HOLIDAY_SYNC_TOKEN=cole-aqui-o-token-gerado

# Emails (importação feita / falha). Os mesmos valores do keep-alive.env.
RESEND_API_KEY=
ALERT_EMAIL_TO=
# RESEND_FROM_EMAIL=onboarding@resend.dev
# RESEND_FROM_NAME=PMPlan

# Log em ficheiro (rotação: pmplan-boe-holidays.logrotate).
HOLIDAY_SYNC_LOG=/var/log/pmplan/boe-holidays.log
