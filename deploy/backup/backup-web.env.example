# PMPlan — configuração do serviço de descarga dos backups (pmplan-backup-web.service).
#
# MODELO. O ficheiro real vive em /etc/pmplan/backup-web.env. Ao contrário do backup.env,
# não tem nada de secreto: a URL e a anon key são as mesmas que vão no bundle da app
# (VITE_SUPABASE_URL e VITE_SUPABASE_ANON_KEY do .env). A autorização é feita pela base de
# dados, com o token de quem pede — ver scripts/backup-download-server.mjs.

SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=

BACKUP_ROOT=/var/backups/pmplan
HOST=127.0.0.1
PORT=8081
