# PMPlan — configuração do backup na VPS.
#
# MODELO. O ficheiro real vive em /etc/pmplan/backup.env (root:root, modo 600), fora do
# repositório. O systemd lê-o como root e só depois baixa privilégios, por isso o
# utilizador do serviço nunca consegue ler a palavra-passe da base de dados.

# ─── Ligação ─────────────────────────────────────────────────────────────────
# A palavra-passe da base de dados NÃO é a service_role key nem o token do heartbeat: é
# a password do papel `postgres`, definida em Project Settings → Database. Dá acesso
# total e directo por SQL — é a credencial mais poderosa do projecto a seguir ao JWT
# secret. É por isso que o backup corre com o seu próprio ficheiro de ambiente, separado
# do keep-alive: quem só precisa de escrever heartbeats não tem de conhecer isto.
#
# QUAL A STRING A USAR — obter no dashboard, botão "Connect":
#
#   * "Session pooler" (porta 5432, utilizador postgres.<ref>) — USAR ESTA por omissão.
#     É a única compatível com IPv4, e os projectos free tier já não têm IPv4 na ligação
#     directa. Funciona com pg_dump.
#
#   * "Direct connection" (db.<ref>.supabase.co:5432) — só funciona se a VPS tiver IPv6.
#     Verificar com: curl -6 -sI https://ifconfig.co
#
#   * "Transaction pooler" (porta 6543) — NÃO SERVE. O modo de transacção não suporta as
#     sessões longas nem os cursores que o pg_dump usa; falha a meio, por vezes só com
#     bases de dados grandes, o que faz o problema aparecer tarde.
#
# A password tem de vir percent-encoded se contiver caracteres especiais (@ : / ?).
PGURL=postgresql://postgres.xxxxxxxxxxxx:PASSWORD@aws-0-eu-west-2.pooler.supabase.com:5432/postgres

# ─── Destino e retenção ──────────────────────────────────────────────────────
BACKUP_ROOT=/var/backups/pmplan
BACKUP_LOG=/var/log/pmplan/backup.log

# 7 diários, 4 semanais (domingos), 3 mensais (dia 1). Com hardlinks, um ficheiro
# promovido a semanal/mensal não ocupa espaço duas vezes.
KEEP_DAILY=7
KEEP_WEEKLY=4
KEEP_MONTHLY=3

# ─── Limiares de anomalia ────────────────────────────────────────────────────
# Abaixo de MIN_BYTES o dump é considerado lixo e a execução falha (o ficheiro é
# apagado). A base de dados tem ~12 MB; 10 KB é conservador ao ponto de nunca dar falso
# positivo, mas apanha o dump vazio.
MIN_BYTES=10240

# Encolher mais de SHRINK_PCT% face ao backup anterior gera alerta, mas o backup É
# GUARDADO — pode ser uma limpeza legítima de dados. O alerta serve para se olhar antes
# de os backups antigos expirarem.
SHRINK_PCT=50

# ─── Alertas ─────────────────────────────────────────────────────────────────
RESEND_API_KEY=
ALERT_EMAIL_TO=
# RESEND_FROM_EMAIL=onboarding@resend.dev
# RESEND_FROM_NAME=PMPlan
